{
  "risk": {
    "base_score": 0.15,
    "thresholds": {
      "low_max": 0.35,
      "high_min": 0.70
    },
    "weights": {
      "query": 0.55,
      "document": 0.30,
      "role": 0.15
    },
    "forced_high_patterns": [
      "repeat the context",
      "complete record",
      "list all personal information",
      "reveal everything",
      "ignore privacy",
      "exact personal details",
      "full private record"
    ],
    "pattern_groups": [
      {
        "label": "Direct identifier request",
        "weight": 0.55,
        "terms": [
          "phone number",
          "email address",
          "home address",
          "account number",
          "aadhaar",
          "social security",
          "full name"
        ]
      },
      {
        "label": "Sensitive subject",
        "weight": 0.25,
        "terms": [
          "diagnosis",
          "treatment",
          "medication",
          "prescribed",
          "medical record",
          "salary",
          "income",
          "bank balance",
          "account balance"
        ]
      },
      {
        "label": "Person-specific request",
        "weight": 0.20,
        "terms": [
          "patient",
          "customer",
          "employee",
          "individual",
          "person-specific"
        ]
      },
      {
        "label": "General-information intent",
        "weight": -0.20,
        "terms": [
          "what is",
          "explain",
          "in general",
          "commonly",
          "general information"
        ]
      },
      {
        "label": "Aggregate intent",
        "weight": -0.10,
        "terms": [
          "average",
          "overall trend",
          "aggregate",
          "how many"
        ]
      }
    ]
  },
  "roles": {
    "public": 1.0,
    "guest": 1.0,
    "patient": 0.6,
    "customer": 0.6,
    "doctor": 0.2,
    "admin": 0.2,
    "unknown": 1.0
  },
  "retrieval": {
    "top_k": 2
  },
  "integrity": {
    "block_context_exfiltration": true
  },
  "reidentification": {
    "k_min": 2,
    "exempt_roles": ["doctor", "admin"]
  },
  "generation": {
    "enabled": true,
    "provider": "groq",
    "model": "openai/gpt-oss-20b",
    "base_url": "https://api.groq.com/openai/v1",
    "api_key_env": "GROQ_API_KEY",
    "reasoning_effort": "low",
    "temperature": 0.1,
    "max_output_tokens": 350,
    "timeout_seconds": 15,
    "max_prompt_chars": 4000,
    "max_contexts": 2,
    "memory_cache": true,
    "limits": {
      "daily_attempts": 300,
      "requests_per_minute": 25,
      "daily_tokens": 150000
    }
  },
  "session": {
    "decay": 0.72,
    "thresholds": {
      "medium": 0.30,
      "high": 0.55,
      "block": 0.85
    },
    "signals": {
      "query_risk": 0.22,
      "new_attribute": 0.08,
      "repeated_document": 0.12,
      "attribute_diversity": 0.06,
      "attack_pattern": 0.35,
      "role_change": 0.30,
      "unverified_role_claim": 0.25,
      "prior_block": 0.20
    },
    "budgets": {
      "quasi_types": 3,
      "sensitive_types": 2
    },
    "max_history": 20
  },
  "purpose": {
    "default": "general_information",
    "rules": {
      "general_information": {
        "roles": ["public", "guest", "patient", "customer", "doctor", "admin"],
        "allowed_types": [],
        "enforce_attribute_scope": true
      },
      "treatment": {
        "roles": ["patient", "doctor"],
        "allowed_types": ["age", "location", "date", "diagnosis", "treatment"],
        "enforce_attribute_scope": true
      },
      "billing": {
        "roles": ["customer", "admin"],
        "allowed_types": ["account_number", "balance", "date", "organization"],
        "enforce_attribute_scope": true
      },
      "customer_support": {
        "roles": ["customer", "admin"],
        "allowed_types": ["account_number", "balance", "date", "location"],
        "enforce_attribute_scope": true
      },
      "hr_review": {
        "roles": ["admin"],
        "allowed_types": ["age", "location", "date", "organization", "salary"],
        "enforce_attribute_scope": true
      },
      "administration": {
        "roles": ["admin"],
        "allowed_types": ["name", "phone", "email", "address", "account_number", "age", "location", "date", "organization", "diagnosis", "treatment", "salary", "balance"],
        "enforce_attribute_scope": true
      }
    }
  },
  "ledger": {
    "budgets": {
      "quasi_attributes": 3,
      "sensitive_attributes": 2,
      "documents": 4
    }
  }
}
